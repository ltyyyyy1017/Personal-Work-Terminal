WORKBENCH_DATA_DIR=./data
# 所有模式必须登录；本机首次打开页面创建个人主账号。
# 云端首次启动可同时配置以下两项，之后在页面设置中修改。
# WORKBENCH_USERNAME=your-owner-name
# WORKBENCH_PASSWORD=replace-with-a-strong-password
# 云端二维码使用的固定 HTTPS 地址；本机局域网模式自动选择电脑 IP。
# WORKBENCH_PUBLIC_URL=https://workbench.example.com
# WORKBENCH_SECURE_COOKIE=true
# 云端迁移完成后禁止网页创建新账号；账号文件丢失时拒绝提供服务。
# WORKBENCH_LOCK_SETUP=true
# 仅用于绑定回环地址且 Nginx 覆盖 X-Workbench-Client-IP 的部署。
# WORKBENCH_TRUST_PROXY=true
# 可将保管库密钥存放在数据目录之外的受保护文件中。
# WORKBENCH_VAULT_KEY_FILE=/etc/personal-workbench/vault.key
TZ=Asia/Shanghai
# 可选。也可在本机设置页填写，凭据加密保存。
# DEEPSEEK_API_KEY=your-deepseek-api-key

# 以下均为可选连接配置，不提供默认工作网站。
# EQUIPMENT_BASE_URL=https://your-equipment-service.example
# DEVICE_LOGIN_HOST=your-equipment-service.example
# NEWS_LOGIN_HOST=your-login-service.example
