{
  "manifest_version": 3,
  "name": "个人工作台登录助手",
  "version": "2.0.0",
  "description": "由本机工作台在设备管理、新闻审核原站中按需填写登录信息。",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:3939/*",
    "http://localhost:3939/*",
    "https://equipment.example.invalid/*",
    "https://login.example.invalid/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3939/*",
        "http://localhost:3939/*"
      ],
      "js": [
        "workbench.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://login.example.invalid/*",
        "https://equipment.example.invalid/*"
      ],
      "js": [
        "form-fill.js",
        "frame-fill.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
